{
  "schemaVersion": 1,
  "id": "reflash",
  "version": "${version}",
  "name": "ReFlash",
  "description": "Vulkan-friendly ReFlash replay manager, custom cut UI and embedded Momenton recorder.",
  "authors": [
    "ReFlash Project"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.reflash.client.ReFlashClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "momenton": ">=1.0.0"
  },
  "breaks": {
    "flashback": "*"
  },
  "icon": "assets/reflash/icon.png",
  "jars": [
    {
      "file": "META-INF/jars/momenton-1.0.0.jar"
    }
  ]
}
