{
  "schemaVersion": 1,
  "id": "reflash",
  "version": "${version}",
  "name": "ReFlash",
  "description": "ReFlash recording and cinematic replay editor with one integrated, GPL-derived replay engine and native .reflash archives.",
  "authors": [
    "ReFlash Project"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.reflash.client.ReFlashClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "breaks": {
    "flashback": "*",
    "momenton": "*"
  },
  "icon": "assets/reflash/icon.png"
}
